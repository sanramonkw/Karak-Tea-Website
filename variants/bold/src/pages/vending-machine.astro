---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Vending Machine - Karak Tea"
  description="Karak Tea vending machines — serve authentic karak tea anywhere. Browse and order vending machines and refills."
  lang="en"
  path="/vending-machine/"
  alternatePath="/ar/آلات-التوزيع/"
>
  <div id="top"></div>
  <PageHero title="Vending Machine" />

  <section class="mesh-light py-20 md:py-28">
    <div class="mx-auto max-w-5xl px-5" data-reveal="zoom">
      <a
        href={SITE.shop.vendingTagEn}
        target="_blank"
        rel="noopener noreferrer"
        class="media-frame"
      >
        <img
          src={withBase('/images/English-scaled.webp')}
          alt="Karak Tea vending machine"
          width="960"
          height="774"
          class="mx-auto w-full"
          loading="lazy"
        />
      </a>
    </div>
  </section>
</BaseLayout>
