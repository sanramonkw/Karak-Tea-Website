---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DistributorCard from '../../components/DistributorCard.astro';
import { DISTRIBUTORS } from '../../data/distributors';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/paths';
---

<BaseLayout
  title="اتصل بنا - شاي كرك"
  description="تواصل مع شاي كرك — المقر الرئيسي في الكويت، وموزعون دوليون في المملكة المتحدة وكندا وأمريكا ومصر والإمارات والبحرين وقطر والأردن والعراق وجنوب أفريقيا."
  lang="ar"
  path="/ar/اتصل-بنا/"
  alternatePath="/contact-us/"
>
  <div id="top"></div>
  <PageHero title="اتصل بنا" />

  <section class="mesh-light py-20 md:py-24">
    <div class="mx-auto grid max-w-7xl items-start gap-10 px-5 lg:grid-cols-4">
      <div class="contact-panel mesh-dark lg:sticky lg:top-28" data-reveal="left">
        <form class="contact-form" id="contact-form" aria-label="نموذج التواصل">
          <p><input type="text" name="your-name" placeholder="الاسم الكامل *" required maxlength="400" /></p>
          <p><input type="email" name="your-email" placeholder="البريد الإلكتروني *" required maxlength="400" /></p>
          <p><input type="tel" name="your-phone" placeholder="الهاتف *" required maxlength="400" /></p>
          <p><textarea name="your-message" placeholder="...رسالتك" rows="6" maxlength="2000"></textarea></p>
          <p class="text-center"><button type="submit">إرسال</button></p>
        </form>
      </div>

      <div class="lg:col-span-3" data-reveal>
        <h2 class="sr-only">موزعونا الدوليون</h2>
        <div class="grid grid-cols-2 gap-5 md:grid-cols-3 xl:grid-cols-4">
          {DISTRIBUTORS.map((d) => (
            <DistributorCard {...d} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ email: SITE.email }}>
    document.getElementById('contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = e.target;
      const subject = encodeURIComponent('استفسار من الموقع - ' + f['your-name'].value);
      const body = encodeURIComponent(
        f['your-message'].value + '\n\nالهاتف: ' + f['your-phone'].value + '\nالبريد: ' + f['your-email'].value,
      );
      window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
    });
  </script>
</BaseLayout>
