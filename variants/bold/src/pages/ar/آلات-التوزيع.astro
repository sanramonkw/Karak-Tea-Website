---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/paths';
---

<BaseLayout
  title="آلات التوزيع - شاي كرك"
  description="آلات توزيع شاي كرك — قدّم شاي كرك الأصيل في أي مكان. تصفح واطلب آلات التوزيع وعبوات إعادة التعبئة."
  lang="ar"
  path="/ar/آلات-التوزيع/"
  alternatePath="/vending-machine/"
>
  <div id="top"></div>
  <PageHero title="آلات التوزيع" />

  <section class="mesh-light py-20 md:py-28">
    <div class="mx-auto max-w-5xl px-5" data-reveal="zoom">
      <a
        href={SITE.shop.vendingTagAr}
        target="_blank"
        rel="noopener noreferrer"
        class="media-frame"
      >
        <img
          src={withBase('/images/Arabic-scaled.webp')}
          alt="آلة توزيع شاي كرك"
          width="960"
          height="774"
          class="mx-auto w-full"
          loading="lazy"
        />
      </a>
    </div>
  </section>
</BaseLayout>
