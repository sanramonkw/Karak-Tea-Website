---
import { NAV_EN, NAV_AR, SITE } from '../data/site';

interface Props {
  lang?: 'en' | 'ar';
}
const { lang = 'en' } = Astro.props;
const nav = lang === 'ar' ? NAV_AR : NAV_EN;
const homeHref = lang === 'ar' ? '/ar/' : '/';
const langSwitch = lang === 'ar'
  ? { label: 'EN', href: '/' }
  : { label: 'العربية', href: '/ar/' };
const siteName = lang === 'ar' ? SITE.nameAr : SITE.nameEn;
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '/ar/';
---

<header id="site-header">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between px-5 md:px-10">
    <a href={homeHref} title={siteName} rel="home" class="flex shrink-0 items-center gap-3">
      <img
        src="/images/branding/Karak_New.png"
        alt={siteName}
        class="logo-main h-auto"
        width="220"
        height="204"
      />
    </a>

    <nav aria-label={lang === 'ar' ? 'التنقل الرئيسي' : 'Main navigation'} class="hidden lg:block">
      <ul class="flex items-center gap-7 xl:gap-9">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              aria-current={currentPath === item.href && !isHome ? 'page' : undefined}
              class:list={['nav-link', item.external && 'nav-cta']}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={langSwitch.href}
            lang={lang === 'ar' ? 'en' : 'ar'}
            class="nav-link"
          >
            {langSwitch.label}
          </a>
        </li>
      </ul>
    </nav>

    <button
      id="mobile-nav-open"
      type="button"
      class="flex h-11 w-11 flex-col items-center justify-center gap-[7px] lg:hidden"
      aria-label={lang === 'ar' ? 'افتح القائمة' : 'Open menu'}
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <span class="block h-px w-7 bg-cream" aria-hidden="true"></span>
      <span class="block h-px w-7 bg-cream" aria-hidden="true"></span>
      <span class="block h-px w-7 bg-champagne" aria-hidden="true"></span>
    </button>
  </div>
</header>

<!-- mobile overlay nav — dark glass -->
<div
  id="mobile-nav"
  class="fixed inset-0 z-[60] hidden flex-col items-center justify-center gap-2 text-center"
>
  <button
    id="mobile-nav-close"
    type="button"
    class="absolute top-5 text-5xl font-light leading-none text-champagne ltr:right-6 rtl:left-6"
    aria-label={lang === 'ar' ? 'أغلق القائمة' : 'Close menu'}
  >
    &times;
  </button>
  <img src="/images/branding/Karak_New.png" alt={siteName} class="mb-8 h-20 w-auto" />
  <nav aria-label={lang === 'ar' ? 'قائمة الجوال' : 'Mobile navigation'}>
    <ul class="space-y-5">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class:list={[
              'font-[family-name:var(--font-heading)] text-2xl font-bold',
              item.external ? 'text-champagne' : 'text-cream',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-3">
        <a
          href={langSwitch.href}
          lang={lang === 'ar' ? 'en' : 'ar'}
          class="font-[family-name:var(--font-heading)] text-xl font-bold text-brand-light"
        >
          {langSwitch.label}
        </a>
      </li>
    </ul>
  </nav>
</div>

<script>
  const openBtn = document.getElementById('mobile-nav-open');
  const closeBtn = document.getElementById('mobile-nav-close');
  const overlay = document.getElementById('mobile-nav');
  openBtn?.addEventListener('click', () => {
    overlay?.classList.remove('hidden');
    overlay?.classList.add('flex');
    openBtn.setAttribute('aria-expanded', 'true');
    (closeBtn as HTMLElement | null)?.focus();
  });
  const close = () => {
    overlay?.classList.add('hidden');
    overlay?.classList.remove('flex');
    openBtn?.setAttribute('aria-expanded', 'false');
    (openBtn as HTMLElement | null)?.focus();
  };
  closeBtn?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay && !overlay.classList.contains('hidden')) close();
  });

  // header condenses into a dark glass bar after a short scroll
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('shrinked', window.scrollY > 25);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
