---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const faqs = [
  {
    q: 'أين يقع المقر الرئيسي لكم؟',
    aHtml:
      'يقع مقرّنا الرئيسي في <strong>دولة الكويت</strong>. وللاستفسارات الدولية أو أي معلومات إضافية، يُرجى التواصل معنا عبر البريد الإلكتروني: <strong><a href="mailto:info@karaktea.com">info@karaktea.com</a></strong>',
    aText:
      'يقع مقرّنا الرئيسي في دولة الكويت. وللاستفسارات الدولية أو أي معلومات إضافية، يُرجى التواصل معنا عبر البريد الإلكتروني: info@karaktea.com',
  },
  {
    q: 'في أي الدول تتواجد منتجاتكم؟',
    aHtml:
      '<p>نتواجد في الدول التالية:</p><p><strong>الشرق الأوسط:</strong> الكويت، دولة قطر، البحرين، الإمارات العربية المتحدة، سلطنة عُمان، المملكة العربية السعودية، الأردن، فلسطين، العراق</p><p><strong>دول أخرى:</strong> كندا، الولايات المتحدة، المملكة المتحدة، مصر، جنوب أفريقيا</p>',
    aText:
      'نتواجد في الدول التالية: الشرق الأوسط: الكويت، دولة قطر، البحرين، الإمارات العربية المتحدة، سلطنة عُمان، المملكة العربية السعودية، الأردن، فلسطين، العراق. دول أخرى: كندا، الولايات المتحدة، المملكة المتحدة، مصر، جنوب أفريقيا',
  },
  {
    q: 'أين يمكنني الاطلاع على منتجاتكم وأسعارها؟',
    aHtml:
      'تتوفر جميع منتجاتنا وأسعارها عبر موقعنا الرسمي: <strong><a href="https://thiafa.com/ar/" target="_blank" rel="noopener">www.thiafa.com</a></strong><br />كما تتوفر منتجاتنا في الجمعيات التعاونية والأسواق التجارية الكبرى.',
    aText:
      'تتوفر جميع منتجاتنا وأسعارها عبر موقعنا الرسمي: www.thiafa.com كما تتوفر منتجاتنا في الجمعيات التعاونية والأسواق التجارية الكبرى.',
  },
  {
    q: 'هل تقدمون خدمة التوصيل داخل وخارج الكويت؟',
    aHtml:
      'نعم، نقدم خدمة التوصيل داخل دولة الكويت، بالإضافة إلى الشحن الدولي إلى الدول المذكورة أعلاه.',
    aText:
      'نعم، نقدم خدمة التوصيل داخل دولة الكويت، بالإضافة إلى الشحن الدولي إلى الدول المذكورة أعلاه.',
  },
  {
    q: 'كم يستغرق وقت التوصيل والشحن؟',
    aHtml:
      '<p>الكويت: يتم توصيل الطلبات خلال 24 ساعة.<br />الدولي: يستغرق الشحن عادةً من 3 إلى 5 أيام عمل حسب الوجهة وإجراءات شركة الشحن.</p><p>لطلبات التجزئة، يمكنكم زيارة متجرنا الإلكتروني: <a href="https://thiafa.com/ar/" target="_blank" rel="noopener">www.thiafa.com</a><br />للدول غير المدرجة، يُرجى التواصل معنا عبر البريد الإلكتروني: <a href="mailto:info@karaktea.com">info@karaktea.com</a> للحصول على مزيد من المعلومات.</p>',
    aText:
      'الكويت: يتم توصيل الطلبات خلال 24 ساعة. الدولي: يستغرق الشحن عادةً من 3 إلى 5 أيام عمل حسب الوجهة وإجراءات شركة الشحن. لطلبات التجزئة، يمكنكم زيارة متجرنا الإلكتروني: www.thiafa.com للدول غير المدرجة، يُرجى التواصل معنا عبر البريد الإلكتروني: info@karaktea.com',
  },
  {
    q: 'ما هي منتجاتكم؟',
    aHtml:
      'يمكنكم استعراض جميع المنتجات المتاحة من خلال قسم <strong><a href="/ar/المنتجات/"><u>المنتجات</u></a></strong>.',
    aText: 'يمكنكم استعراض جميع المنتجات المتاحة من خلال قسم المنتجات.',
  },
  {
    q: 'ما هي أفضل طريقة لتحضير منتجاتكم؟',
    aHtml:
      'يمكنكم الاطلاع على أفضل طرق التحضير في قسم <strong><a href="/ar/التحضير/"><u>طريقة التحضير</u></a></strong>.',
    aText: 'يمكنكم الاطلاع على أفضل طرق التحضير في قسم طريقة التحضير.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'ar',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.aText },
  })),
};
---

<BaseLayout
  title="أسئلة مكررة - شاي كرك"
  description="الأسئلة الشائعة حول شاي كرك — المقر الرئيسي، الدول المتوفرة، أماكن الشراء، التوصيل، مدة الشحن وطريقة التحضير."
  lang="ar"
  path="/ar/أسئلة-مكررة/"
  alternatePath="/faqs/"
  jsonLd={[faqSchema]}
>
  <div id="top"></div>
  <PageHero title="أسئلة مكررة" />

  <section class="py-16 md:py-24">
    <div class="faq reveal mx-auto max-w-3xl px-5 md:px-10">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="faq-answer space-y-3" set:html={f.aHtml} />
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
