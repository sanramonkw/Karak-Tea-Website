---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="التحضير - شاي كرك"
  description="طريقة تحضير شاي كرك — سهل التحضير في أقل من دقيقة. دليل التحضير بالخطوات مع فيديو توضيحي."
  lang="ar"
  path="/ar/التحضير/"
  alternatePath="/preparation/"
>
  <div id="top"></div>
  <PageHero title="التحضير" />

  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-5xl px-5 text-center md:px-10">
      <figure class="framed framed-plum reveal mb-14">
        <img
          src="/images/Easy-to-prepare-arabic-scaled.webp"
          alt="خطوات تحضير شاي كرك — سهل التحضير"
          class="mx-auto w-full"
          loading="lazy"
        />
      </figure>
      <div class="reveal aspect-video w-full overflow-hidden border border-brand/15 bg-plum-950">
        <iframe
          title="مشغل فيديو يوتيوب"
          src="https://www.youtube.com/embed/0DdPepASq1w?si=CeroOMH-d9klONzD"
          width="100%"
          height="435"
          class="h-full w-full"
          frameborder="0"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
