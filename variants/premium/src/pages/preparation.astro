---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Karak Tea - Preparation"
  description="How to prepare Karak Tea instant premix — easy to prepare in less than a minute. Step-by-step preparation guide and video."
  lang="en"
  path="/preparation/"
  alternatePath="/ar/التحضير/"
>
  <div id="top"></div>
  <PageHero title="Preparation" />

  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-5xl px-5 text-center md:px-10">
      <figure class="framed framed-plum reveal mb-14">
        <img
          src={withBase('/images/Easy-to-prepare-English-scaled.webp')}
          alt="Karak Tea preparation steps — easy to prepare"
          class="mx-auto w-full"
          loading="lazy"
        />
      </figure>
      <div class="reveal aspect-video w-full overflow-hidden border border-brand/15 bg-plum-950">
        <iframe
          title="YouTube video player"
          src="https://www.youtube.com/embed/0DdPepASq1w?si=CeroOMH-d9klONzD"
          width="100%"
          height="435"
          class="h-full w-full"
          frameborder="0"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
