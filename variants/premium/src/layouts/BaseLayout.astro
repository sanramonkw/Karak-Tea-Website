---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ar';
  /** path of this page, e.g. "/products/" */
  path: string;
  /** path of the same page in the other language (for hreflang), if any */
  alternatePath?: string;
  ogImage?: string;
  /** extra JSON-LD blocks (already-serializable objects) */
  jsonLd?: object[];
}

const {
  title,
  description,
  lang = 'en',
  path,
  alternatePath,
  ogImage = '/images/branding/Karak_New.png',
  jsonLd = [],
} = Astro.props;

const dir = lang === 'ar' ? 'rtl' : 'ltr';
const canonical = new URL(path, SITE.url).href;
const ogImageAbs = new URL(ogImage, SITE.url).href;
const siteName = lang === 'ar' ? SITE.nameAr : SITE.nameEn;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: 'Karak Tea',
  alternateName: 'شاي كرك',
  url: `${SITE.url}/`,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/images/branding/Karak_New.png', SITE.url).href,
  },
  email: SITE.email,
  telephone: SITE.phoneDisplay,
  address: { '@type': 'PostalAddress', addressCountry: 'KW' },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SITE.phoneDisplay,
    email: SITE.email,
    contactType: 'customer service',
    availableLanguage: ['en', 'ar'],
  },
  sameAs: [
    SITE.social.facebook,
    SITE.social.twitter,
    SITE.social.instagram,
  ],
  brand: { '@type': 'Brand', name: 'Karak Tea' },
  parentOrganization: {
    '@type': 'Organization',
    name: 'San Ramon General Trading',
    url: 'https://sanramonkw.com/en/',
  },
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    {/* hreflang alternates */}
    <link rel="alternate" href={canonical} hreflang={lang} />
    {alternatePath && (
      <link
        rel="alternate"
        href={new URL(alternatePath, SITE.url).href}
        hreflang={lang === 'en' ? 'ar' : 'en'}
      />
    )}

    {/* Open Graph */}
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_AR'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageAbs} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    {/* premium variant: preload the display serif; gate reveal styles on JS */}
    <link rel="preload" href="/fonts/CormorantGaramond-var.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="skip-link">{lang === 'ar' ? 'تخطي إلى المحتوى' : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Scroll reveal — IntersectionObserver adds .in-view once.
      // CSS only animates under (prefers-reduced-motion: no-preference).
      const revealed = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && revealed.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in-view');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        revealed.forEach((el) => io.observe(el));
      } else {
        revealed.forEach((el) => el.classList.add('in-view'));
      }

      // Subtle parallax on the leaf veils — transform-only, rAF-throttled,
      // disabled entirely when the user prefers reduced motion.
      const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)');
      const veils = Array.from(document.querySelectorAll<HTMLElement>('.leaf-veil[data-parallax]'));
      if (motionOK.matches && veils.length) {
        let ticking = false;
        const update = () => {
          ticking = false;
          const vh = window.innerHeight;
          for (const veil of veils) {
            const rect = (veil.parentElement ?? veil).getBoundingClientRect();
            if (rect.bottom < 0 || rect.top > vh) continue;
            const progress = (rect.top + rect.height / 2 - vh / 2) / vh; // -1..1
            veil.style.transform = `translate3d(0, ${(-progress * 42).toFixed(1)}px, 0)`;
          }
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        update();
      }
    </script>
  </body>
</html>
