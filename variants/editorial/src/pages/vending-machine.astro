---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Vending Machine - Karak Tea"
  description="Karak Tea vending machines — serve authentic karak tea anywhere. Browse and order vending machines and refills."
  lang="en"
  path="/vending-machine/"
  alternatePath="/ar/آلات-التوزيع/"
>
  <div id="top"></div>
  <PageHero title="Vending Machine" />

  <section class="py-14 md:py-20">
    <div class="mx-auto max-w-4xl px-5 md:px-10">
      <a href={SITE.shop.vendingTagEn} target="_blank" rel="noopener noreferrer" class="plate">
        <img
          src={withBase('/images/English-scaled.webp')}
          alt="Karak Tea vending machine"
          width="960"
          height="774"
          class="w-full"
        />
      </a>
    </div>
  </section>
</BaseLayout>
