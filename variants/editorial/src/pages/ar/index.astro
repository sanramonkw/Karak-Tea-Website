---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSlider from '../../components/HeroSlider.astro';
import SplitSection from '../../components/SplitSection.astro';
import { SITE } from '../../data/site';

const sliderText =
  'شاي كرك الأكثر مبيعًا في منطقة الخليج متميز في النكهة الخاصة والمكونات التقليدية وطريقة التحضير المتميز. خلطات شاي كرك متنوعة لإرضاء جميع الأذواق والرغبات وسريعة التحضير. سواء كانت محلاة أو غير محلاة يمكنك تحضير جميع النكهات في أقل من دقيقة! استمتع بكوب دافئ من شاي كرك في أي وقت!';

const slides = [
  { image: '/images/slide01b.jpg', title: 'شاي كرك', text: sliderText, ctaLabel: 'تسوق الآن', ctaHref: SITE.shop.ar },
  { image: '/images/slide01a.jpg', title: 'شاي كرك', text: sliderText, ctaLabel: 'تسوق الآن', ctaHref: 'https://srkw.co/' },
  { image: '/images/slide01d.jpg', title: 'شاي كرك', text: sliderText, ctaLabel: 'تسوق الآن', ctaHref: 'https://srkw.co/' },
];
---

<BaseLayout
  title="الرئيسية - شاي كرك"
  description="مرحبًا بكم في شاي كرك، حيث نحرص على تزويد عشاق الكرك بأجود المكونات المختارة بعناية من جميع أنحاء العالم."
  lang="ar"
  path="/ar/"
  alternatePath="/"
>
  <div id="top"></div>

  <HeroSlider slides={slides} lang="ar" />

  <div class="features">
  <SplitSection variant={1} image="/images/1.webp" imageAlt="كوب دافئ من شاي كرك" title="شاي كرك">
    <p>
      هو نوع من أنواع الشاي الذي يطبخ بطريقة مختلفة عن أنواع الشاي الأخرى، فالكرك كلمة تشير الى
      التحضير بتكرار عملية غلي الشاي كناية عن الشاي الثقيل وهو لفظ بلغة الاوردو الهندية وقد عرفه
      أهل الخليج بشكل عام منذ عقود حين كانت العلاقات التجارية بين الهند ودول الخليج في أوجها وكان
      التجار الخليجيون يرحلون للهند ليأتوا بالبضائع المختلفة، ومن هناك بدأ شاي الكرك رحلته إلى دول
      الخليج.
    </p>
  </SplitSection>

  <SplitSection variant={2} image="/images/2-ar.webp" imageAlt="نكهات وخلطات شاي كرك" title="منتج شاي كرك">
    <ul class="checked-list">
      <li>
        شاي كرك مصنوع من أجود أنواع الشاي الكيني الغني بالحليب وخلاصة قصب السكر. مع توفر نكهات
        اختيارية لنقدم أفضل تجربة. نكهاتنا هي الهيل و الزعفران الكشميري والقهوة والزنجبيل والقرفة.
      </li>
      <li>
        يتم الحفاظ على طعم وجودة المكونات من خلال استخدام اكياس سهلة الفتح عالية الجودة. ويأتي شاي
        كرك أيضا في كبسولات متوافقة مع أجهزة "دولتشي غوستو" والعديد من أجهزة تحضير القهوة الأخرى.
      </li>
    </ul>
  </SplitSection>

  <SplitSection variant={1} image="/images/3.webp" imageAlt="تحضير شاي كرك التقليدي" title="رحلتنا">
    <p>
      بدأت رحلتنا بتطوير منتج مميز من شاي الكرك الذي يمكن تحضيره في غضون ثوانٍ، مع الحفاظ على العبق
      الأصيل وثراء شاي الكرك التقليدي. بالرغم من تجنب استخدام أي مواد حافظة أو ملونات طعام صناعية،
      نجحنا في إنتاج شاي الكرك الذي يحتوي على كالسيوم الحليب والفيتامينات والمعادن المفيدة. قد يكون
      من انسب معززات الطاقة الطبيعية، شاي كرك مشروب الضيافة والدفء. لقد طورنا المزيد من النكهات في
      رحلتنا الطويلة وكل نكهة هي نجمة بحد ذاتها، أمضينا سنوات في تقديم الحب ونعتبر أنفسنا في بداية
      رحلتنا لأن لدينا الكثير والكثير لنقدمه
    </p>
  </SplitSection>

  <SplitSection variant={2} image="/images/4.webp" imageAlt="منتجات علامة شاي كرك" title="من نحن">
    <ul class="checked-list">
      <li>
        شاي كرك ، علامة تجارية مسجلة وملكيتها لشركة
        <strong><a href="https://sanramonkw.com/ar/">سان ريمون للتجارة العامة</a></strong>
        ، تم تصنيعها في الهند من قبل مصنع إنتاج شاي كرك "Aastha Enterprises"
      </li>
      <li>
        نفخر لأننا الخيار الأول لعشاق شاي الكرك في جميع أنحاء العالم! نقدم منتجاتنا محليا ودوليا
        للعملاء والموزعين.
      </li>
      <li>
        خلطات شاي كرك سريعة التحضير هي منتجات عالية الجودة. "تذوق شاي كرك مرة واحدة ونحن نضمن أنه
        سيكون الأعلى مرتبة في قائمة المشروبات الساخنة الخاصة بك!"
      </li>
    </ul>
  </SplitSection>
  </div>
</BaseLayout>
