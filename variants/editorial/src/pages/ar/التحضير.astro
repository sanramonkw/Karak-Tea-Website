---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout
  title="التحضير - شاي كرك"
  description="طريقة تحضير شاي كرك — سهل التحضير في أقل من دقيقة. دليل التحضير بالخطوات مع فيديو توضيحي."
  lang="ar"
  path="${withBase('/ar/التحضير/')}"
  alternatePath="/preparation/"
>
  <div id="top"></div>
  <PageHero title="التحضير" />

  <section class="py-14 md:py-20">
    <div class="mx-auto max-w-4xl px-5 md:px-10">
      <span class="plate mb-12 block"><img
        src={withBase('/images/Easy-to-prepare-arabic-scaled.webp')}
        alt="خطوات تحضير شاي كرك — سهل التحضير"
        class="w-full"
      /></span>
      <div class="plate"><div class="aspect-video w-full overflow-hidden">
        <iframe
          title="مشغل فيديو يوتيوب"
          src="https://www.youtube.com/embed/0DdPepASq1w?si=CeroOMH-d9klONzD"
          width="100%"
          height="435"
          class="h-full w-full"
          frameborder="0"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div></div>
    </div>
  </section>
</BaseLayout>
