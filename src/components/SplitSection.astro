---
/**
 * Port of the WP "#wrap-section.half-background1/2" pattern:
 * a split-color band (leaves pattern overlay) with image on one side
 * and heading + copy on the other.
 */
interface Props {
  variant: 1 | 2; // 1 = purple/white (white text), 2 = white/light purple
  image: string;
  imageAlt?: string;
  title: string;
}
const { variant, image, imageAlt = '', title } = Astro.props;
---

{/*
  Column layout ported from the WP markup: a 12-col row where the image is
  col-md-5 and the copy is col-md-6 (+1 col offset between them, 50px inner
  padding). Grid columns follow the inline axis, so RTL mirrors automatically.
*/}
<section class:list={[variant === 1 ? 'half-bg-1' : 'half-bg-2', 'py-20']}>
  <div class="mx-auto grid max-w-7xl items-center gap-y-10 px-4 md:grid-cols-12">
    {variant === 1 ? (
      <>
        <div class="md:col-span-5 md:px-[10px]">
          <img src={image} alt={imageAlt} loading="lazy" class="w-full border border-white" />
        </div>
        <div class="md:col-span-6 md:col-start-7 md:px-[50px]">
          <h2 class="mb-[10px] mt-[60px] text-[40px] leading-[40px] text-white">{title}</h2>
          <span class="brand-line" aria-hidden="true"></span>
          <div class="space-y-4 text-white [&_a]:underline">
            <slot />
          </div>
        </div>
      </>
    ) : (
      <>
        <div class="md:col-span-6 md:px-[50px]">
          <h2 class="mb-[10px] mt-[60px] text-[40px] leading-[40px] text-brand">{title}</h2>
          <span class="brand-line" aria-hidden="true"></span>
          <div class="space-y-4 [&_a]:font-bold [&_a]:text-brand [&_a]:underline">
            <slot />
          </div>
        </div>
        <div class="md:col-span-5 md:col-start-8 md:px-[10px]">
          <img src={image} alt={imageAlt} loading="lazy" class="w-full border border-white" />
        </div>
      </>
    )}
  </div>
</section>
