---
/**
 * "Story" section — bold-variant replacement for the WP half-background
 * split bands. Asymmetric 12-col composition, giant decorative index number,
 * tilted overlapping image card, scroll-reveal. Copy comes through the slot
 * verbatim. Variant 1 = dark electric field, variant 2 = light mesh.
 */
interface Props {
  variant: 1 | 2;
  image: string;
  imageAlt?: string;
  title: string;
  /** decorative section index, e.g. "01" */
  index?: string;
}
const { variant, image, imageAlt = '', title, index = '' } = Astro.props;
const dark = variant === 1;
---

<section
  class:list={[
    dark ? 'mesh-dark cut-both' : 'mesh-light',
    'relative overflow-hidden py-24 md:py-32',
  ]}
>
  <div class="relative mx-auto grid max-w-7xl items-center gap-y-12 px-5 md:grid-cols-12">
    {dark ? (
      <>
        <div class="md:col-span-5" data-reveal="left">
          <img src={image} alt={imageAlt} loading="lazy" class="story-img w-full" width="800" height="600" />
        </div>
        <div class="relative md:col-span-6 md:col-start-7" data-reveal>
          {index && (
            <span class="story-index absolute -top-14 text-outline opacity-70 ltr:-left-2 rtl:-right-2" aria-hidden="true">
              {index}
            </span>
          )}
          <h2 class="display-title relative text-electric-bright">{title}</h2>
          <span class="title-swash" aria-hidden="true"></span>
          <div class="space-y-4 text-[1.05rem] leading-relaxed text-white/95 [&_a]:font-bold [&_a]:text-brand-light [&_a]:underline">
            <slot />
          </div>
        </div>
      </>
    ) : (
      <>
        <div class="relative md:col-span-6" data-reveal>
          {index && (
            <span class="story-index absolute -top-14 text-brand-light/60 ltr:-left-2 rtl:-right-2" aria-hidden="true">
              {index}
            </span>
          )}
          <h2 class="display-title relative text-electric">{title}</h2>
          <span class="title-swash" aria-hidden="true"></span>
          <div class="space-y-4 text-[1.05rem] leading-relaxed [&_a]:font-bold [&_a]:text-brand [&_a]:underline">
            <slot />
          </div>
        </div>
        <div class="md:col-span-5 md:col-start-8" data-reveal="right">
          <img src={image} alt={imageAlt} loading="lazy" class="story-img w-full" width="800" height="600" />
        </div>
      </>
    )}
  </div>
</section>
