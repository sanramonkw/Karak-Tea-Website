---
interface Props {
  name: string;
  image: string;
  href: string;
}
const { name, image, href } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" class="card-product">
  <h2>{name}</h2>
  <img src={image} alt={name} width="550" height="550" loading="lazy" class="mx-auto w-full" />
</a>
