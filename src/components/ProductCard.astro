---
/**
 * Bento product card — interactive tile with gradient-shift hover,
 * lift + tilt, and a reveal-on-hover shop hint.
 */
interface Props {
  name: string;
  image: string;
  href: string;
  /** extra classes (bento column/row spans from the page grid) */
  class?: string;
}
const { name, image, href, class: className = '' } = Astro.props;
const isAr = Astro.url.pathname.startsWith('/ar');
const ctaLabel = isAr ? 'تسوق الآن' : 'Shop Now';
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['bento-card', className]}
>
  <h2>{name}</h2>
  <img src={image} alt={name} width="550" height="550" loading="lazy" class="mx-auto w-full" />
  <span class="card-cta" aria-hidden="true">{ctaLabel} &#8599;</span>
</a>
