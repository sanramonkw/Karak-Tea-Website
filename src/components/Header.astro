---
import { NAV_EN, NAV_AR, SITE } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  lang?: 'en' | 'ar';
}
const { lang = 'en' } = Astro.props;
const nav = lang === 'ar' ? NAV_AR : NAV_EN;
const homeHref = lang === 'ar' ? '/ar/' : '/';
const langSwitch = lang === 'ar'
  ? { label: 'EN', href: '/' }
  : { label: 'العربية', href: '/ar/' };
const siteName = lang === 'ar' ? SITE.nameAr : SITE.nameEn;
// Astro.url.pathname includes the base prefix at runtime; strip it so
// comparisons against the base-agnostic hrefs above keep working.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(new RegExp(`^${base}`), '') || '/';
const isHome = currentPath === '/' || currentPath === '/ar/';
// Original theme nav link: black, 16px, 'Font-Bold', uppercase; active page purple.
const navLinkBase =
  'inline-block py-5 font-[family-name:var(--font-heading)] text-[16px] font-bold uppercase';
---

<header
  id="site-header"
  class:list={[
    'fixed top-0 z-50 w-full bg-white py-[10px] transition-all duration-300',
    !isHome && 'border-b border-[#ededed]',
  ]}
>
  <div class="mx-auto flex max-w-7xl items-start justify-between px-4">
    <a href={withBase(homeHref)} title={siteName} rel="home" class="flex items-start">
      <img
        src={withBase('/images/branding/Karak_New.png')}
        alt={siteName}
        class="logo-main h-auto w-[120px]"
        width="220"
        height="204"
      />
      <img
        src={withBase('/images/branding/logo-text.png')}
        alt=""
        aria-hidden="true"
        class="logo-text ms-[15px] mt-[22px] hidden h-auto w-[110px] sm:block"
      />
    </a>

    <nav aria-label={lang === 'ar' ? 'التنقل الرئيسي' : 'Main navigation'} class="mt-5 hidden lg:block">
      <ul class="flex items-center">
        {nav.map((item) => (
          <li class="mx-[15px]">
            <a
              href={item.external ? item.href : withBase(item.href)}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              aria-current={currentPath === item.href ? 'page' : undefined}
              class:list={[
                navLinkBase,
                // quirk kept from the live WP site: the home page shows no
                // active highlight — only inner pages tint their nav item.
                currentPath === item.href && !isHome ? 'text-brand' : 'text-black',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="mx-[15px]">
          <a
            href={withBase(langSwitch.href)}
            lang={lang === 'ar' ? 'en' : 'ar'}
            class:list={[navLinkBase, 'text-black']}
          >
            {langSwitch.label}
          </a>
        </li>
      </ul>
    </nav>

    <button
      id="mobile-nav-open"
      type="button"
      class="self-center text-3xl text-brand lg:hidden"
      aria-label={lang === 'ar' ? 'افتح القائمة' : 'Open menu'}
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      &#9776;
    </button>
  </div>
</header>

<!-- mobile overlay nav -->
<div
  id="mobile-nav"
  class="fixed inset-0 z-[60] hidden flex-col items-center justify-center gap-2 bg-white/95 text-center backdrop-blur"
>
  <button
    id="mobile-nav-close"
    type="button"
    class="absolute top-5 text-4xl text-brand ltr:right-6 rtl:left-6"
    aria-label={lang === 'ar' ? 'أغلق القائمة' : 'Close menu'}
  >
    &times;
  </button>
  <img src={withBase('/images/branding/Karak_New.png')} alt={siteName} class="mb-6 h-20 w-auto" />
  <nav aria-label={lang === 'ar' ? 'قائمة الجوال' : 'Mobile navigation'}>
    <ul class="space-y-4">
      {nav.map((item) => (
        <li>
          <a
            href={item.external ? item.href : withBase(item.href)}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="font-[family-name:var(--font-heading)] text-2xl font-bold text-brand"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={withBase(langSwitch.href)}
          lang={lang === 'ar' ? 'en' : 'ar'}
          class="font-[family-name:var(--font-heading)] text-2xl font-bold text-brand-deep"
        >
          {langSwitch.label}
        </a>
      </li>
    </ul>
  </nav>
</div>

<script>
  const openBtn = document.getElementById('mobile-nav-open');
  const closeBtn = document.getElementById('mobile-nav-close');
  const overlay = document.getElementById('mobile-nav');
  openBtn?.addEventListener('click', () => {
    overlay?.classList.remove('hidden');
    overlay?.classList.add('flex');
    openBtn.setAttribute('aria-expanded', 'true');
  });
  closeBtn?.addEventListener('click', () => {
    overlay?.classList.add('hidden');
    overlay?.classList.remove('flex');
    openBtn?.setAttribute('aria-expanded', 'false');
  });

  // header shrink on scroll (ported from the WP theme's "shrinked" behavior:
  // scrollTop > 25 → smaller logo, zero vertical padding, 97% white bg)
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('shrinked', window.scrollY > 25);
  });
</script>
