---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="التحضير - شاي كرك"
  description="طريقة تحضير شاي كرك — سهل التحضير في أقل من دقيقة. دليل التحضير بالخطوات مع فيديو توضيحي."
  lang="ar"
  path="/ar/التحضير/"
  alternatePath="/preparation/"
>
  <div id="top"></div>
  <PageHero title="التحضير" />

  <section class="py-20">
    <div class="mx-auto max-w-5xl px-4 text-center">
      <img
        src="/images/Easy-to-prepare-arabic-scaled.webp"
        alt="خطوات تحضير شاي كرك — سهل التحضير"
        class="mx-auto mb-10 w-full"
      />
      <div class="aspect-video w-full overflow-hidden">
        <iframe
          title="مشغل فيديو يوتيوب"
          src="https://www.youtube.com/embed/0DdPepASq1w?si=CeroOMH-d9klONzD"
          width="100%"
          height="435"
          class="h-full w-full"
          frameborder="0"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
